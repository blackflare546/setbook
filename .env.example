# Production public sharing uses one Public Vercel Blob store. Connecting the
# project configures BLOB_STORE_ID plus OIDC automatically. Older token-based
# connections use BLOB_READ_WRITE_TOKEN. These values are not interchangeable;
# never put a store ID in BLOB_READ_WRITE_TOKEN. Local development falls back
# to data/published-setlists/ when neither Blob variable is present.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
# Random server-only value of at least 32 characters. Required in production.
# It protects shared-setlist capability verifiers and must remain stable.
SHARE_CAPABILITY_SECRET=
# Positive number of days a newly published or owner-confirmed link remains active.
PUBLISHED_SETLIST_RETENTION_DAYS=30
# Separate random server-only value of at least 32 characters for cleanup auth.
CRON_SECRET=
# Server-only Formspree form ID used by the feedback API.
FORMSPREE_FORM_ID=
