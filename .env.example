# Production public sharing uses a Public Vercel Blob store. Connecting a
# project currently configures OIDC plus BLOB_STORE_ID automatically. Existing
# token-based stores use BLOB_READ_WRITE_TOKEN. Local development falls back to
# data/published-setlists/ when neither variable is present.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
# Long random server-only value used to protect shared-setlist capability verifiers.
SHARE_CAPABILITY_SECRET=
